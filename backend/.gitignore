node_modules/
.deno/
deno.lock
dist/
build/

# --- Log & sementara ---
*.log
logs/
*.tmp
*.bak
*~

# --- OS / IDE ---
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.iml

# ============================================
