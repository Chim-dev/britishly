# ============================================================
# Britishly — contoh konfigurasi
#
# CARA PAKAI:
#   1. Salin file ini, beri nama ".env" (tanpa .example)
#   2. Ganti kedua nilai di bawah dengan punyamu
#      Ambil dari: dashboard Supabase -> Settings -> API Keys
#
# File .env yang asli TIDAK ikut ke git (sudah diamankan .gitignore).
# File .example ini aman di-commit karena isinya cuma contoh.
# ============================================================

# Settings -> Data API -> Project URL
SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co


# Kunci publik aplikasi. Supabase sedang beralih format, jadi project-mu
# menampilkan SALAH SATU dari dua ini. Isi yang sesuai, biarkan satunya.
#
#   Format lama : "anon" "public"   -> diawali  eyJhbGci...
#   Format baru : "Publishable key" -> diawali  sb_publishable_...
#
# Keduanya sama-sama AMAN ditanam di dalam aplikasi, karena yang menjaga
# data tetap Row Level Security di database.

SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxxxxxxxxxxxxxxx
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx


# ⚠️ JANGAN PERNAH menaruh "service_role" atau "secret key" di sini.
# Key jenis itu mem-bypass seluruh Row Level Security. Kalau tertanam di
# dalam APK, siapa pun yang membongkarnya bisa membaca dan menghapus
# data SELURUH user.

# ============================================================
# Google Sign-In (Native Android / iOS - Opsional)
# Ambil Web Client ID dari Google Cloud Console -> Credentials
# ============================================================
# GOOGLE_WEB_CLIENT_ID=xxxxxxxxxxxxxxxx.apps.googleusercontent.com

# ============================================================
# Google Gemini API (Fitur AI Smart Explanation)
#
# ⛔ JANGAN taruh GEMINI_API_KEY di sini. Sengaja dikosongkan.
#
# File .env ini didaftarkan sebagai asset Flutter di pubspec.yaml, jadi
# seluruh isinya ikut terbungkus apa adanya ke dalam APK. Siapa pun yang
# meng-unzip APK bisa membacanya.
#
# Untuk anon key Supabase itu tidak masalah — key itu memang dirancang
# publik dan yang menjaga data tetap Row Level Security. Tapi Gemini API key
# adalah kredensial BILLING: tidak ada RLS yang menjaganya, dan yang
# mencurinya bisa memakai kuota atas tagihan pemilik aplikasi.
#
# Karena itu pemanggilan Gemini dipindahkan ke Edge Function Supabase.
# Key-nya dipasang sebagai secret di server, tidak pernah dikirim ke HP:
#
#     supabase secrets set GEMINI_API_KEY=...
#
# Langkah lengkapnya ada di supabase/README.md
# ============================================================

